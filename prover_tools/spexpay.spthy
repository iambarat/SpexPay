theory SpexPay

begin

builtins: hashing
functions: s/1, z/0

rule IssueA:
  [ Fr(~uid) ]
  --[ IssuedA(~uid) ]->
  [ !CredA(~uid) ]

rule IssueB:
  [ !CredA(uid), Fr(~sid) ]
  --[ IssuedB(uid,~sid), BoundEv(uid,~sid) ]->
  [ !CredB(uid,~sid), !Bound(uid,~sid) ]

rule Present:
  [ !CredA(uid), !CredB(uid,sid), !Bound(uid,sid), Fr(~ctx), Fr(~ptok) ]
  --[ Presented(uid,sid,~ctx,~ptok) ]->
  [ Out(<vp,uid,sid,~ctx,~ptok>), !Proof(uid,sid,~ctx,~ptok) ]

rule VerifyAndOpen:
  [ In(<vp,uid,sid,ctx,ptok>), !Proof(uid,sid,ctx,ptok), !Bound(uid,sid) ]
  --[ Verified(uid,sid,ctx,ptok), Opened(sid) ]->
  [ Sess(sid,z), !Used(ptok) ]

rule ReplayOpenAttempt:
  [ In(<vp,uid,sid,ctx,ptok>), !Proof(uid,sid,ctx,ptok), !Used(ptok) ]
  --[ ReplayOpen(ptok,sid,ctx) ]->
  [ ]

rule Claim_Step:
  [ Sess(sid,k) ]
  --[ Accepted(sid,s(k)), Progress(sid,k,s(k)) ]->
  [ Sess(sid,s(k)) ]

rule Close:
  [ Sess(sid,k) ]
  --[ Closed(sid,k) ]->
  [ ClosedState(sid,k) ]

lemma open_implies_verified:
  "All sid #i.
     Opened(sid) @ i
     ==>
     (Ex uid ctx ptok #j.
        Verified(uid,sid,ctx,ptok) @ j & j <= i)"

lemma accepted_claim_requires_open:
  "All sid k #i.
     Accepted(sid,k) @ i
     ==>
     (Ex #j. Opened(sid) @ j & j < i)"

lemma proof_token_single_use:
  "All ptok sid1 sid2 uid1 uid2 ctx1 ctx2 #i #j.
     Verified(uid1,sid1,ctx1,ptok) @ i
     & Verified(uid2,sid2,ctx2,ptok) @ j
     ==>
     i = j"

lemma accepted_claim_implies_issuance:
  "All sid k #i.
     Accepted(sid,k) @ i
     ==>
     (Ex uid #j #m.
        IssuedA(uid) @ j
        & IssuedB(uid,sid) @ m)"

lemma functional_trace:
  exists-trace
  "Ex uid sid ctx ptok k #i #j #m #n.
      IssuedA(uid) @ i
      & IssuedB(uid,sid) @ j
      & Opened(sid) @ m
      & Accepted(sid,s(z)) @ n"

end
